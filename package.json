{
  "name": "read-louder",
  "version": "1.0.0",
  "description": "Comprehensive document-to-speech desktop application with advanced reading controls",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -mwl",
    "cli": "node cli.js",
    "api": "node api-server.js"
  },
  "bin": {
    "doc-reader": "./cli.js"
  },
  "keywords": [
    "text-to-speech",
    "document-reader",
    "pdf-reader",
    "accessibility",
    "electron"
  ],
  "author": "Blooming Tree Financials",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.6.0",
    "textract": "^2.5.0",
    "tesseract.js": "^5.0.4",
    "franc": "^6.1.0",
    "chardet": "^1.6.0",
    "natural": "^6.7.0",
    "say": "^0.16.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.34.0",
    "@google-cloud/text-to-speech": "^5.0.1",
    "aws-sdk": "^2.1490.0",
    "openai": "^4.20.1",
    "fluent-ffmpeg": "^2.1.2",
    "lamejs": "^1.2.1",
    "wavefile": "^11.0.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "commander": "^11.1.0",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "lucide-react": "^0.294.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.8",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "wait-on": "^7.2.0",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.bloomingtree.readlouder",
    "productName": "Read Louder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "processors/**/*",
      "src/services/**/*",
      "src/utils/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icons/icon.ico"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/icons/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "icon": "assets/icons/icon.png",
      "category": "Office"
    }
  }
}
