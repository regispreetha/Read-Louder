# TTS Provider API Keys
# =====================

# Azure Cognitive Services
# Get your key from: https://azure.microsoft.com/en-us/services/cognitive-services/speech-services/
AZURE_SPEECH_KEY=your-azure-speech-key-here
AZURE_SPEECH_REGION=eastus

# Google Cloud Text-to-Speech
# Setup guide: https://cloud.google.com/text-to-speech/docs/quickstart-client-libraries
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-credentials.json

# Amazon Polly
# Get credentials from: https://aws.amazon.com/polly/
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# OpenAI TTS
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# API Server Configuration
# ========================
PORT=3001
WEBHOOK_URL=http://n8n.bloomingminds.tech/webhook

# Application Settings
# ====================
NODE_ENV=development
